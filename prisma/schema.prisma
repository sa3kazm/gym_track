// Gym & Nutrition Tracker — схема БД (Частина 1)
// https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Goal {
  LOSS
  GAIN
  MAINTAIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum ExerciseCategory {
  CHEST
  BACK
  LEGS
  SHOULDERS
  ARMS
  CORE
  OTHER
}

enum Equipment {
  BARBELL
  DUMBBELL
  CABLE
  MACHINE
  BODYWEIGHT
  OTHER
}

enum WeightUnit {
  KG
  LB
}

enum FoodCategory {
  MEAT
  FISH
  DAIRY
  GRAINS
  VEGETABLES
  FRUITS
  NUTS
  OILS
  SWEETS
  DRINKS
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

// ─── Profile ─────────────────────────────────────────────────────────────────

model Profile {
  id        String   @id @default(cuid())
  name      String   @default("")
  age       Int?
  gender    Gender   @default(MALE)
  heightCm  Float?
  targetWeightKg Float?
  goal      Goal     @default(MAINTAIN)
  activityLevel ActivityLevel @default(MODERATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bodyMetrics          BodyMetrics[]
  bodyMeasurements     BodyMeasurements?
  trainingPreferences  TrainingPreferences?
  exercises            Exercise[]
  workoutPlans         WorkoutPlan[]
  workoutSessions      WorkoutSession[]
  foods                Food[]
  nutritionEntries     NutritionEntry[]
}

// ─── BodyMetrics (історія ваги / заміри тіла) ───────────────────────────────

model BodyMetrics {
  id             String   @id @default(cuid())
  profileId      String
  recordedAt     DateTime @default(now())
  weightKg       Float
  bodyFatPercent Float?
  note           String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, recordedAt])
}

// ─── BodyMeasurements (обхвати для McCallum / слабкі зони) ───────────────────

model BodyMeasurements {
  id        String   @id @default(cuid())
  profileId String   @unique
  wristCm   Float?
  neckCm    Float?
  chestCm   Float?
  waistCm   Float?
  hipsCm    Float?
  bicepCm   Float?
  forearmCm Float?
  thighCm   Float?
  calfCm    Float?
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── TrainingPreferences (норми КБЖУ, таймер, одиниці) ──────────────────────

model TrainingPreferences {
  id                  String   @id @default(cuid())
  profileId           String   @unique
  defaultRestSeconds  Int      @default(90)
  preferredSplit      String?
  weightUnit          WeightUnit @default(KG)
  dailyCalories       Int      @default(2000)
  dailyProteinG       Int      @default(150)
  dailyFatG           Int      @default(65)
  dailyCarbsG         Int      @default(220)
  dailyWaterMl        Int      @default(2000)
  updatedAt           DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ─── Exercise (бібліотека вправ) ─────────────────────────────────────────────

model Exercise {
  id        String           @id @default(cuid())
  profileId String?
  name      String
  category  ExerciseCategory @default(OTHER)
  equipment Equipment        @default(OTHER)
  isCustom  Boolean          @default(false)
  createdAt DateTime         @default(now())

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([name])
}

// ─── WorkoutPlan (програма: PPL, Upper/Lower тощо) ───────────────────────────

model WorkoutPlan {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  description String?
  /// JSON: { days: WorkoutPlanDay[] }
  schedule    String   @default("{\"days\":[]}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile  Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessions WorkoutSession[]

  @@index([profileId])
}

// ─── WorkoutSession (щоденник тренування) ────────────────────────────────────

model WorkoutSession {
  id            String    @id @default(cuid())
  profileId     String
  workoutPlanId String?
  planDayId     String?
  sessionDate   DateTime  @default(now())
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  totalVolume   Float     @default(0)
  /// JSON: WorkoutSessionExercise[]
  exercises     String    @default("[]")
  notes         String?

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workoutPlan WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)

  @@index([profileId, sessionDate])
  @@index([workoutPlanId])
}

// ─── Food (база продуктів) ───────────────────────────────────────────────────

model Food {
  id             String       @id @default(cuid())
  profileId      String?
  name           String
  category       FoodCategory @default(OTHER)
  caloriesPer100 Float
  proteinPer100  Float
  fatPer100      Float
  carbsPer100    Float
  isCustom       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  profile  Profile?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entries  NutritionEntry[]

  @@index([profileId])
  @@index([name])
}

// ─── NutritionEntry (запис їжі за день) ──────────────────────────────────────

model NutritionEntry {
  id        String   @id @default(cuid())
  profileId String
  logDate   DateTime
  mealType  MealType
  foodId    String
  grams     Float
  calories  Float
  protein   Float
  fat       Float
  carbs     Float
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  food    Food    @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([profileId, logDate])
  @@index([foodId])
}
